{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githappens",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "assets": {
    // Client-side routes (/donors/d7) fall back to index.html
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker; everything else is a static file
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "githappens", "database_id": "7ecb8d1a-5f89-456a-b880-e00ba97d5dfb", "migrations_dir": "migrations" }
  ],
  // Public AuthKit client ID (WorkOS staging environment). Not a secret.
  "vars": { "WORKOS_CLIENT_ID": "client_01M7E3A3JEVSSQCSM38YCBW0VQ" },
  "routes": [{ "pattern": "githappens.jurenka.software", "custom_domain": true, "zone_name": "jurenka.software" }]
}
