{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githappens",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/donors/d7) fall back to index.html
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "githappens.jurenka.software", "custom_domain": true, "zone_name": "jurenka.software" }]
}
