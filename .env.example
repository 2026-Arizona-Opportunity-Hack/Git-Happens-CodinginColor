# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# WorkOS Staging secret key (dashboard → API Keys). The Worker uses it to read
# the board from the CIC organization; `bun run db:seed` uses it too.
WORKOS_API_KEY=sk_test_your-key

# OHack AI gateway key from the team card. The Worker uses it for the chat
# assistant (POST /api/chat). In production it's a Worker secret.
AI_API_KEY=sk-your-key

# Encrypts the sign-in cookie. Any random string of 32+ characters, e.g.
# `head -c 32 /dev/urandom | base64`. In production it's a Worker secret; changing it
# signs everyone out.
WORKOS_COOKIE_PASSWORD=change-me-to-32-random-characters
